<UserControl x:Class="PAD.Desktop.Views.TasksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:PAD.Desktop.Converters">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
        <conv:DateTextConverter x:Key="DateText"/>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,24,32,24" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="Задачи" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource OverdueBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Новая задача" Style="{StaticResource CardTitle}"/>
                    <TextBlock Text="Что нужно сделать" Style="{StaticResource FieldLabel}"/>
                    <TextBox Style="{StaticResource Input}" Text="{Binding NewTitle, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding AddCommand}"/></TextBox.InputBindings>
                    </TextBox>
                    <UniformGrid Rows="1">
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Проект" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding Projects}" DisplayMemberPath="Title" SelectedItem="{Binding NewProject}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Приоритет" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding Priorities}" DisplayMemberPath="Title" SelectedItem="{Binding NewPriority}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Срок (дд.мм.гггг)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Style="{StaticResource Input}"
                                     Text="{Binding NewDue, Converter={StaticResource DateText}, UpdateSourceTrigger=LostFocus}"/>
                        </StackPanel>
                    </UniformGrid>
                    <Button Style="{StaticResource AccentButton}" Command="{Binding AddCommand}" HorizontalAlignment="Left" Margin="0,16,0,0">
                        <TextBlock Text="Добавить задачу" Foreground="{DynamicResource AccentTextBrush}" FontWeight="Medium"/>
                    </Button>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource HoverBrush}" CornerRadius="16" Padding="2" HorizontalAlignment="Left" Margin="0,18,0,10">
                <ListBox ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}"
                         Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource Chip}">
                    <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                    <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title}" FontSize="12" FontWeight="Medium"/></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Border Style="{StaticResource Card}" Padding="12">
                <StackPanel>
                    <TextBlock Text="В этом списке задач нет." Foreground="{DynamicResource TextMutedBrush}" Margin="8"
                               Visibility="{Binding IsEmpty, Converter={StaticResource B2V}}"/>
                    <ItemsControl ItemsSource="{Binding Tasks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Style="{StaticResource GhostButton}" Width="30" Height="30" Padding="0"
                                            ToolTip="Выполнено / вернуть в работу"
                                            Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource AccentBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="&#xE739;"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDone}" Value="True"><Setter Property="Text" Value="&#xE73A;"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Button>
                                    <StackPanel Grid.Column="1" Margin="12,0">
                                        <TextBlock Text="{Binding Title}" FontWeight="Medium" TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                            <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                            <Setter Property="Opacity" Value="0.55"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Sub}" FontSize="12" Foreground="{Binding SubColor}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Priority}" Foreground="{Binding PriorityColor}" FontSize="12" FontWeight="Medium"
                                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <Button Grid.Column="3" Style="{StaticResource GhostButton}" Width="30" Height="30" Padding="0" ToolTip="Удалить"
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource TextMutedBrush}"/>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
