<UserControl x:Class="PAD.Desktop.Views.ProjectsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
    </UserControl.Resources>

    <Grid Margin="8,22,28,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Список проектов -->
        <DockPanel Margin="0,0,20,0">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Command="{Binding NewProjectCommand}"
                        VerticalAlignment="Center">
                    <TextBlock Text="+ Проект" Foreground="White" FontWeight="Medium"/>
                </Button>
                <TextBlock Text="Проекты" Style="{StaticResource PageTitle}"/>
            </DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Поиск по названию, заказчику, описанию" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
            <TextBox DockPanel.Dock="Top" Style="{StaticResource Input}" Margin="0,0,0,10"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
            <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ItemContainerStyle="{StaticResource LegendRow}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition/><RowDefinition/><RowDefinition/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="10" Height="10" CornerRadius="5" Background="{Binding CategoryColor}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Margin="8,0,8,0"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="2" Text="{Binding PriceText}" FontSize="13" FontWeight="Medium"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Client}" FontSize="12"
                                       Foreground="{DynamicResource TextMutedBrush}" Margin="8,2,0,0" TextTrimming="CharacterEllipsis"/>
                            <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="8,4,0,0">
                                <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="Medium" Foreground="{Binding StatusColor}"/>
                                <TextBlock Text="  ·  " FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding PayText}" FontSize="12" FontWeight="Medium" Foreground="{Binding PayColor}"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Правая панель -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{Binding Error}" Foreground="{DynamicResource OverdueBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap"
                           Visibility="{Binding ShowEmpty, Converter={StaticResource B2V}}"
                           Text="Выберите проект слева или создайте новый кнопкой «+ Проект»."/>

                <!-- Создание проекта -->
                <Border Visibility="{Binding IsCreating, Converter={StaticResource B2V}}"
                        Background="{DynamicResource SurfaceBrush}" CornerRadius="14" Padding="22">
                    <StackPanel>
                        <TextBlock Text="Новый проект" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="Название" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource Input}" Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Заказчик" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource Input}" Text="{Binding NewClient, UpdateSourceTrigger=PropertyChanged}"/>
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="Категория" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding Categories}" DisplayMemberPath="Name" SelectedItem="{Binding NewCategory}"/>
                            </StackPanel>
                            <StackPanel Margin="8,0,0,0">
                                <TextBlock Text="Статус" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding StatusOptions}" DisplayMemberPath="Title" SelectedItem="{Binding NewStatus}"/>
                            </StackPanel>
                        </UniformGrid>
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="Стоимость" Style="{StaticResource FieldLabel}"/>
                                <TextBox Style="{StaticResource Input}" FontSize="16" Text="{Binding NewPrice, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Margin="8,0,0,0">
                                <TextBlock Text="Валюта" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding Currencies}" SelectedItem="{Binding NewCurrency}" Height="34"/>
                            </StackPanel>
                        </UniformGrid>
                        <TextBlock Text="Крайний срок сдачи" Style="{StaticResource FieldLabel}"/>
                        <DatePicker SelectedDate="{Binding NewDeadline}" HorizontalAlignment="Left" Width="200"/>
                        <TextBlock Text="Описание" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource Input}" Height="80" AcceptsReturn="True" TextWrapping="Wrap"
                                 Text="{Binding NewDescription, UpdateSourceTrigger=PropertyChanged}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <Button Style="{StaticResource AccentButton}" Command="{Binding CreateProjectCommand}">
                                <TextBlock Text="Создать проект" Foreground="White" FontWeight="Medium"/>
                            </Button>
                            <Button Style="{StaticResource GhostButton}" Command="{Binding CancelCreateCommand}" Margin="8,0,0,0">
                                <TextBlock Text="Отмена"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Карточка проекта -->
                <StackPanel Visibility="{Binding ShowDetail, Converter={StaticResource B2V}}">
                    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="14" Padding="22">
                        <StackPanel>
                            <TextBlock Text="{Binding DetailName}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding DetailSub}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <TextBlock Text="Статус проекта" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ComboBox ItemsSource="{Binding StatusOptions}" DisplayMemberPath="Title"
                                          SelectedItem="{Binding SelectedStatus}" MinWidth="170"/>
                                <TextBlock Text="Оплата:" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="22,0,6,0"/>
                                <TextBlock Text="{Binding DetailPay}" FontWeight="SemiBold" Foreground="{Binding DetailPayColor}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding DetailTiles}" ItemTemplate="{StaticResource MoneyTileTemplate}" Margin="0,14,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Style="{StaticResource AccentButton}" Command="{Binding OpenDeliveryCommand}"
                                Visibility="{Binding CanDeliver, Converter={StaticResource B2V}}">
                            <TextBlock Text="Зафиксировать сдачу" Foreground="White" FontWeight="Medium"/>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Command="{Binding ReopenCommand}"
                                Visibility="{Binding CanReopen, Converter={StaticResource B2V}}">
                            <TextBlock Text="Открыть проект повторно"/>
                        </Button>
                    </StackPanel>

                    <!-- Сдача проекта -->
                    <Border Visibility="{Binding IsDelivering, Converter={StaticResource B2V}}" Margin="0,14,0,0"
                            Background="{DynamicResource SurfaceBrush}" CornerRadius="14" Padding="22">
                        <StackPanel>
                            <TextBlock Text="Сдача проекта заказчику" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap"
                                       Text="Сдача не означает получения денег: оплата учитывается отдельно, в платежах."/>
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="Финальная стоимость" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Style="{StaticResource Input}" Text="{Binding DelivPrice, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Margin="8,0,0,0">
                                    <TextBlock Text="Дата сдачи" Style="{StaticResource FieldLabel}"/>
                                    <DatePicker SelectedDate="{Binding DelivDate}"/>
                                </StackPanel>
                            </UniformGrid>
                            <TextBlock Text="Ссылка на готовый продукт" Style="{StaticResource FieldLabel}"/>
                            <TextBox Style="{StaticResource Input}" Text="{Binding DelivUrl, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="Результат передачи заказчику" Style="{StaticResource FieldLabel}"/>
                            <TextBox Style="{StaticResource Input}" Text="{Binding DelivResult, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="Комментарий" Style="{StaticResource FieldLabel}"/>
                            <TextBox Style="{StaticResource Input}" Height="60" AcceptsReturn="True" TextWrapping="Wrap"
                                     Text="{Binding DelivComment, UpdateSourceTrigger=PropertyChanged}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                <Button Style="{StaticResource AccentButton}" Command="{Binding ConfirmDeliveryCommand}">
                                    <TextBlock Text="Подтвердить сдачу" Foreground="White" FontWeight="Medium"/>
                                </Button>
                                <Button Style="{StaticResource GhostButton}" Command="{Binding CancelDeliveryCommand}" Margin="8,0,0,0">
                                    <TextBlock Text="Отмена"/>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Платежи -->
                    <TextBlock Text="ПЛАТЕЖИ" Style="{StaticResource SectionTitle}"/>
                    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="14" Padding="22">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/><ColumnDefinition Width="190"/><ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="Сумма" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                    <TextBox Style="{StaticResource Input}" Text="{Binding PayAmount, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                    <TextBlock Text="Тип" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding PaymentTypes}" DisplayMemberPath="Title" SelectedItem="{Binding PayType}" Height="34"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                    <TextBlock Text="Дата" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                    <DatePicker SelectedDate="{Binding PayDate}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="Назначение" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                    <TextBox Style="{StaticResource Input}" Text="{Binding PayPurpose, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Style="{StaticResource AccentButton}" Command="{Binding AddPaymentCommand}">
                                    <TextBlock Text="Добавить платёж" Foreground="White" FontWeight="Medium"/>
                                </Button>
                                <CheckBox Content="Деньги получены" IsChecked="{Binding PayIsReceived}" Margin="16,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap"
                                       Text="В заработок попадают только платежи с отметкой «Деньги получены». Валюта платежа — валюта проекта."/>

                            <ItemsControl ItemsSource="{Binding Payments}" Margin="0,10,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="90"/><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="90"/><ColumnDefinition Width="30"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Date}" Foreground="{DynamicResource TextMutedBrush}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Type}" FontWeight="Medium"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Purpose}" Foreground="{DynamicResource TextMutedBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Amount}" FontWeight="SemiBold" Margin="8,0"/>
                                                <TextBlock Grid.Column="4" Text="{Binding Received}" FontSize="12" TextAlignment="Right"
                                                           Foreground="{DynamicResource TextMutedBrush}"/>
                                                <Button Grid.Column="5" Content="✕" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                        ToolTip="Удалить платёж"
                                                        Command="{Binding DataContext.DeletePaymentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
