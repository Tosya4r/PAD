<UserControl x:Class="PAD.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:PAD.Desktop.Controls">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8,22,28,24">
            <TextBlock Text="Главная" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="{Binding DateLine}" Foreground="{DynamicResource TextMutedBrush}" FontSize="14" Margin="0,2,0,0"/>
            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource OverdueBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>

            <TextBlock Text="ПРОЕКТЫ" Style="{StaticResource SectionTitle}"/>
            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="14">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.07" Color="#101828"/>
                </Border.Effect>
                <ItemsControl ItemsSource="{Binding CountTiles}" ItemTemplate="{StaticResource CountTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Border>

            <TextBlock Text="ФИНАНСЫ" Style="{StaticResource SectionTitle}"/>
            <ItemsControl ItemsSource="{Binding FinanceTiles}" ItemTemplate="{StaticResource MoneyTileTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>


            <TextBlock Text="ЗАРАБОТОК ПО КАТЕГОРИЯМ" Style="{StaticResource SectionTitle}"/>
            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="14" Padding="24">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.07" Color="#101828"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Width="290" Height="290" VerticalAlignment="Top">
                        <c:DonutChart Slices="{Binding Slices}" SelectedId="{Binding SelectedCategoryId, Mode=TwoWay}"/>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="150" IsHitTestVisible="False">
                            <TextBlock Text="{Binding CenterTitle}" FontSize="13" TextAlignment="Center" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding CenterValue}" FontSize="24" FontWeight="SemiBold" TextAlignment="Center"
                                       TextWrapping="Wrap" Margin="0,4,0,2"/>
                            <TextBlock Text="{Binding CenterSub}" FontSize="12" TextAlignment="Center" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                    </Grid>

                    <DockPanel Grid.Column="1" Margin="28,0,0,0">
                        <Border DockPanel.Dock="Top" Background="{DynamicResource HoverBrush}" CornerRadius="10" Padding="2"
                                HorizontalAlignment="Left" Margin="0,0,0,12">
                            <ListBox ItemsSource="{Binding Periods}" SelectedItem="{Binding SelectedPeriod}"
                                     Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource Chip}">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="Medium"/></DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
                            <TextBlock Text="Новая категория — цвет подберётся автоматически" FontSize="12"
                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}"
                                        Command="{Binding AddCategoryCommand}" Margin="8,0,0,0">
                                    <TextBlock Text="Добавить" Foreground="White" FontWeight="Medium"/>
                                </Button>
                                <TextBox Style="{StaticResource Input}"
                                         Text="{Binding NewCategoryName, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding AddCategoryCommand}"/>
                                    </TextBox.InputBindings>
                                </TextBox>
                            </DockPanel>
                        </StackPanel>

                        <ListBox ItemsSource="{Binding Legend}" SelectedValuePath="Id"
                                 SelectedValue="{Binding SelectedCategoryId}" MaxHeight="260"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ItemContainerStyle="{StaticResource LegendRow}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="64"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="12" Height="12" CornerRadius="6" Background="{Binding Color}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13.5" FontWeight="Medium"
                                                   Margin="10,0,8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Amount}" FontSize="13" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Percent}" FontSize="13" TextAlignment="Right"
                                                   Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Grid>
            </Border>


            <TextBlock Text="ДИНАМИКА ЗАРАБОТКА" Style="{StaticResource SectionTitle}"/>
            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="14" Padding="24,18,24,12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.07" Color="#101828"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Наведите на столбец — точная сумма, нажмите — поступления месяца ниже." FontSize="12"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8"/>
                    <c:BarChart Height="210" Bars="{Binding Bars}" SelectedKey="{Binding SelectedMonthKey, Mode=TwoWay}"/>
                </StackPanel>
            </Border>

            <DockPanel Margin="2,22,0,10">
                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding ClearFiltersCommand}"
                        Visibility="{Binding HasFilters, Converter={StaticResource B2V}}">
                    <TextBlock Text="Сбросить фильтры" FontSize="12"/>
                </Button>
                <TextBlock Text="{Binding EarningsTitle}" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center"/>
            </DockPanel>
            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="14" Padding="14">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.07" Color="#101828"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Поступлений за выбранный период пока нет." Foreground="{DynamicResource TextMutedBrush}"
                               Margin="10,8" Visibility="{Binding NoEarnings, Converter={StaticResource B2V}}"/>
                    <ItemsControl ItemsSource="{Binding Earnings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource RowButton}" ToolTip="Открыть проект"
                                        Command="{Binding DataContext.OpenProjectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding ProjectId}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="190"/><ColumnDefinition Width="130"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="10" Height="10" CornerRadius="5" Background="{Binding CategoryColor}" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Margin="10,0,8,0">
                                            <TextBlock Text="{Binding Project}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Sub}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TypeText}" FontSize="12.5"/>
                                            <TextBlock Text="{Binding DateText}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="3" Text="{Binding AmountText}" FontWeight="SemiBold" FontSize="14"
                                                   TextAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <TextBlock Margin="2,16,0,0" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap"
                       Text="Заработок — только фактически полученные платежи. Договорная стоимость в него не входит."/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
