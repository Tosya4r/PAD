<UserControl x:Class="PAD.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:PAD.Desktop.Controls">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,24,32,24">
            <TextBlock Text="{Binding Greeting}" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="{Binding DateLine}" Foreground="{DynamicResource TextMutedBrush}" FontSize="14" Margin="0,2,0,16"/>
            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource OverdueBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>

            <ItemsControl ItemsSource="{Binding CountTiles}" ItemTemplate="{StaticResource CountTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <Grid Margin="0,24,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="340"/>
                </Grid.ColumnDefinitions>

                <StackPanel Margin="0,0,16,0">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,16">
                                <Border DockPanel.Dock="Right" Background="{DynamicResource HoverBrush}" CornerRadius="16" Padding="2">
                                    <ListBox ItemsSource="{Binding Periods}" SelectedItem="{Binding SelectedPeriod}"
                                             Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource Chip}">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate><TextBlock Text="{Binding Title}" FontSize="12" FontWeight="Medium"/></DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                                <TextBlock Text="Финансы" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding FinanceTiles}" ItemTemplate="{StaticResource MiniTileTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <TextBlock Text="Динамика заработка · наведите на столбец — сумма, нажмите — поступления месяца ниже"
                                       FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,16,0,4"/>
                            <c:BarChart Height="190" Bars="{Binding Bars}" SelectedKey="{Binding SelectedMonthKey, Mode=TwoWay}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Заработок по категориям" Style="{StaticResource CardTitle}" Margin="0,0,0,16"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="260"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid Width="250" Height="250" VerticalAlignment="Top">
                                    <c:DonutChart Slices="{Binding Slices}" SelectedId="{Binding SelectedCategoryId, Mode=TwoWay}"/>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="130" IsHitTestVisible="False">
                                        <TextBlock Text="{Binding CenterTitle}" FontSize="12" TextAlignment="Center" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding CenterValue}" FontSize="20" FontWeight="SemiBold" TextAlignment="Center"
                                                   TextWrapping="Wrap" Margin="0,4,0,2"/>
                                        <TextBlock Text="{Binding CenterSub}" FontSize="11" TextAlignment="Center" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextMutedBrush}"/>
                                    </StackPanel>
                                </Grid>
                                <DockPanel Grid.Column="1" Margin="18,0,0,0">
                                    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                                        <TextBlock Text="Новая категория — цвет подберётся автоматически" FontSize="12"
                                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}"
                                                    Command="{Binding AddCategoryCommand}" Margin="8,0,0,0">
                                                <TextBlock Text="Добавить" Foreground="{DynamicResource AccentTextBrush}" FontWeight="Medium"/>
                                            </Button>
                                            <TextBox Style="{StaticResource Input}"
                                                     Text="{Binding NewCategoryName, UpdateSourceTrigger=PropertyChanged}">
                                                <TextBox.InputBindings>
                                                    <KeyBinding Key="Enter" Command="{Binding AddCategoryCommand}"/>
                                                </TextBox.InputBindings>
                                            </TextBox>
                                        </DockPanel>
                                    </StackPanel>
                        <ListBox ItemsSource="{Binding Legend}" SelectedValuePath="Id"
                                 SelectedValue="{Binding SelectedCategoryId}" MaxHeight="240"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ItemContainerStyle="{StaticResource LegendRow}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="64"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="12" Height="12" CornerRadius="16" Background="{Binding Color}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" FontWeight="Medium"
                                                   Margin="10,0,8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Amount}" FontSize="13" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Percent}" FontSize="13" TextAlignment="Right"
                                                   Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                                </DockPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

            <DockPanel Margin="0,18,0,10">
                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding ClearFiltersCommand}"
                        Visibility="{Binding HasFilters, Converter={StaticResource B2V}}">
                    <TextBlock Text="Сбросить фильтры" FontSize="12"/>
                </Button>
                <TextBlock Text="{Binding EarningsTitle}" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center"/>
            </DockPanel>
            <Border Style="{StaticResource Card}" Padding="12">
                <StackPanel>
                    <TextBlock Text="Поступлений за выбранный период пока нет." Foreground="{DynamicResource TextMutedBrush}"
                               Margin="10,8" Visibility="{Binding NoEarnings, Converter={StaticResource B2V}}"/>
                    <ItemsControl ItemsSource="{Binding Earnings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource RowButton}" ToolTip="Открыть проект"
                                        Command="{Binding DataContext.OpenProjectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding ProjectId}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="190"/><ColumnDefinition Width="130"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="10" Height="10" CornerRadius="12" Background="{Binding CategoryColor}" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Margin="10,0,8,0">
                                            <TextBlock Text="{Binding Project}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Sub}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TypeText}" FontSize="12"/>
                                            <TextBlock Text="{Binding DateText}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="3" Text="{Binding AmountText}" FontWeight="SemiBold" FontSize="14"
                                                   TextAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>


                    <TextBlock Margin="2,14,0,0" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap"
                               Text="Заработок — только фактически полученные платежи. Договорная стоимость в него не входит."/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                <Border Style="{StaticResource Card}" Margin="0,0,0,16" Padding="20,16">
                    <StackPanel>
                        <TextBlock Text="Ближайшие события" Style="{StaticResource CardTitle}" Margin="0,0,0,8"/>
                        <TextBlock Text="Сроков и ожидаемых оплат пока нет." Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" FontSize="12"
                                   Visibility="{Binding NoEvents, Converter={StaticResource B2V}}"/>
                        <ItemsControl ItemsSource="{Binding Events}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource RowButton}" Command="{Binding DataContext.OpenProjectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding ProjectId}">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="30" Height="30" CornerRadius="12" Background="{Binding Color}" Opacity="0.9">
                                                <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#0F1114"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Margin="10,0,0,0" MaxWidth="250">
                                                <TextBlock Text="{Binding Title}" FontWeight="Medium" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding DateText}" FontSize="11" Foreground="{Binding Color}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,0,16" Padding="20,16">
                    <StackPanel>
                        <TextBlock Text="Последние проекты" Style="{StaticResource CardTitle}" Margin="0,0,0,8"/>
                        <TextBlock Text="Проектов пока нет — создайте первый кнопкой сверху." Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" FontSize="12"
                                   Visibility="{Binding NoRecent, Converter={StaticResource B2V}}"/>
                        <ItemsControl ItemsSource="{Binding Recent}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource RowButton}" Command="{Binding DataContext.OpenProjectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Id}">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}" FontSize="11" FontWeight="Medium" Foreground="{Binding StatusColor}" Margin="8,0,0,0"/>
                                                <TextBlock Text="{Binding Name}" FontWeight="Medium" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                            <Grid Margin="0,6,0,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <ProgressBar Value="{Binding PaidPercent, Mode=OneWay}" Maximum="100" Height="5" VerticalAlignment="Center"
                                                             Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource LineBrush}" BorderThickness="0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding PercentText}" FontSize="11" Margin="8,0,0,0" Foreground="{DynamicResource TextMutedBrush}"/>
                                            </Grid>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Полоса — сколько от стоимости уже оплачено." FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="10,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,0,16" Padding="20,16">
                    <StackPanel>
                        <TextBlock Text="Мои задачи" Style="{StaticResource CardTitle}" Margin="0,0,0,8"/>
                        <TextBlock Text="Открытых задач нет." Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" FontSize="12"
                                   Visibility="{Binding NoTasks, Converter={StaticResource B2V}}"/>
                        <ItemsControl ItemsSource="{Binding MyTasks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="4,5">
                                        <Button DockPanel.Dock="Left" Style="{StaticResource GhostButton}" Padding="0" Width="24" Height="24"
                                                ToolTip="Отметить выполненной"
                                                Command="{Binding DataContext.CompleteTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding Id}">
                                            <TextBlock Text="&#xE739;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource TextMutedBrush}"/>
                                        </Button>
                                        <StackPanel Margin="10,0,0,0">
                                            <TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Sub}" FontSize="11" Foreground="{Binding DueColor}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,0,16" Padding="20,16">
                    <StackPanel>
                        <TextBlock Text="Журнал активности" Style="{StaticResource CardTitle}" Margin="0,0,0,8"/>
                        <TextBlock Text="Событий пока нет." Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" FontSize="12"
                                   Visibility="{Binding NoActivity, Converter={StaticResource B2V}}"/>
                        <ItemsControl ItemsSource="{Binding Activity}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="4,5">
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                   Foreground="{Binding Color}" VerticalAlignment="Top" Margin="0,2,10,0"/>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding When}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="8,2,0,0" VerticalAlignment="Top"/>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Text}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Sub}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
