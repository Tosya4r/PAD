<UserControl x:Class="PAD.Desktop.Views.FinanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8,8,28,24">
            <TextBlock Text="Финансы" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Суммы разных валют не смешиваются — каждая считается отдельно." Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,16"/>
            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource OverdueBrush}" TextWrapping="Wrap"/>

            <ItemsControl ItemsSource="{Binding Tiles}" ItemTemplate="{StaticResource CountTemplate}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>

            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Топ проектов по доходу" Style="{StaticResource CardTitle}" Margin="0,0,0,8"/>
                        <TextBlock Text="Полученных платежей пока нет." Foreground="{DynamicResource TextMutedBrush}"
                                   Visibility="{Binding NoTop, Converter={StaticResource B2V}}"/>
                        <ItemsControl ItemsSource="{Binding Top}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource RowButton}"
                                            Command="{Binding DataContext.OpenProjectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Id}">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Received}" FontWeight="SemiBold"/>
                                                <Border DockPanel.Dock="Left" Width="10" Height="10" CornerRadius="5" Background="{Binding CategoryColor}" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                            <Grid Margin="0,6,0,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" Height="5"
                                                             Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource LineBrush}" BorderThickness="0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Price}" FontSize="11.5" Margin="8,0,0,0" Foreground="{DynamicResource TextMutedBrush}"/>
                                            </Grid>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Ожидаемые платежи" Style="{StaticResource CardTitle}" Margin="0,0,0,8"/>
                        <TextBlock Text="Неоплаченных остатков нет." Foreground="{DynamicResource TextMutedBrush}"
                                   Visibility="{Binding NoExpected, Converter={StaticResource B2V}}"/>
                        <ItemsControl ItemsSource="{Binding Expected}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource RowButton}"
                                            Command="{Binding DataContext.OpenProjectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding ProjectId}">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding Amount}" FontWeight="SemiBold" TextAlignment="Right"/>
                                                <TextBlock Text="{Binding StatusText}" FontSize="11.5" Foreground="{Binding Color}" TextAlignment="Right"/>
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Project}" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding Client, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding DueText, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </DockPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Margin="10,10,0,0" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"
                                   Text="Срок оплаты считается по крайнему сроку проекта."/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
