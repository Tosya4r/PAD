<UserControl x:Class="PAD.Desktop.Views.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8,8,28,24" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="Результаты поиска" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,16"/>
            <Border Style="{StaticResource Card}" Padding="10">
                <ItemsControl ItemsSource="{Binding Hits}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource RowButton}"
                                    Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                               Foreground="{Binding Color}" Width="30" VerticalAlignment="Center"/>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding KindText}" FontSize="12" Foreground="{Binding Color}" VerticalAlignment="Center"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Hit.Title}" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Hit.Sub}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DockPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
