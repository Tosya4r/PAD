<UserControl x:Class="PAD.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8,22,28,24" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Text="Настройки" Style="{StaticResource PageTitle}"/>

            <TextBlock Text="ХРАНИЛИЩЕ" Style="{StaticResource SectionTitle}"/>
            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="14" Padding="22">
                <StackPanel>
                    <TextBlock Text="Все данные хранятся только на этом компьютере. Интернет и аккаунт не нужны."
                               TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}"/>
                    <TextBlock Text="Файл базы данных" Style="{StaticResource FieldLabel}"/>
                    <TextBox Style="{StaticResource Input}" Text="{Binding DbPath, Mode=OneWay}" IsReadOnly="True"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <TextBlock Text="Размер:" Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding DbSize}" Margin="6,0,0,0" FontWeight="Medium"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Style="{StaticResource GhostButton}" Command="{Binding OpenFolderCommand}">
                            <TextBlock Text="Открыть папку с данными"/>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Command="{Binding CheckIntegrityCommand}" Margin="8,0,0,0">
                            <TextBlock Text="Проверить целостность"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="РЕЗЕРВНЫЕ КОПИИ" Style="{StaticResource SectionTitle}"/>
            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="14" Padding="22">
                <StackPanel>
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}"
                               Text="PAD автоматически делает копию раз в день при запуске и хранит последние 7. Копия — это ZIP со всеми проектами, платежами, категориями и настройками."/>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Style="{StaticResource AccentButton}" Command="{Binding CreateBackupCommand}">
                            <TextBlock Text="Создать копию…" Foreground="White" FontWeight="Medium"/>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Command="{Binding RestoreCommand}" Margin="8,0,0,0">
                            <TextBlock Text="Восстановить из копии…"/>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="Автоматические копии" Style="{StaticResource FieldLabel}" Margin="0,18,0,6"/>
                    <ItemsControl ItemsSource="{Binding AutoBackups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="12.5" Margin="0,2"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <TextBlock Text="ЭКСПОРТ" Style="{StaticResource SectionTitle}"/>
            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="14" Padding="22">
                <StackPanel>
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}"
                               Text="История всех платежей в CSV: открывается в Excel. Возвраты — отрицательные суммы."/>
                    <Button Style="{StaticResource GhostButton}" Command="{Binding ExportPaymentsCommand}"
                            HorizontalAlignment="Left" Margin="0,14,0,0">
                        <TextBlock Text="Экспорт платежей в CSV…"/>
                    </Button>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="2,16,0,0" FontWeight="Medium">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                        <Setter Property="Foreground" Value="{DynamicResource IncomeBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource OverdueBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <TextBlock Text="{Binding Version}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="2,22,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
