<UserControl x:Class="PAD.Desktop.Views.ArchiveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8,8,28,24" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="Архив" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Архивные проекты скрыты из списка, но их платежи по-прежнему входят в заработок." TextWrapping="Wrap"
                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,16"/>
            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource OverdueBrush}" TextWrapping="Wrap"/>
            <Border Style="{StaticResource Card}" Padding="12">
                <StackPanel>
                    <TextBlock Text="Архив пуст. Проект можно отправить сюда кнопкой «В архив» в его карточке." Foreground="{DynamicResource TextMutedBrush}"
                               TextWrapping="Wrap" Margin="8" Visibility="{Binding IsEmpty, Converter={StaticResource B2V}}"/>
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="6,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Sub}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                                        <TextBlock FontSize="12" Foreground="{DynamicResource TextMutedBrush}">
                                            <Run Text="{Binding Status, Mode=OneWay}" Foreground="{Binding StatusColor}"/><Run Text="  ·  "/><Run Text="{Binding Money, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource GhostButton}" Margin="8,0" VerticalAlignment="Center"
                                            Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <TextBlock Text="Вернуть"/>
                                    </Button>
                                    <Button Grid.Column="2" Style="{StaticResource GhostButton}" VerticalAlignment="Center"
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <TextBlock Text="Удалить" Foreground="{DynamicResource OverdueBrush}"/>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
