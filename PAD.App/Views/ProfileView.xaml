<UserControl x:Class="PAD.Desktop.Views.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,24,32,24" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Text="Мой профиль" Style="{StaticResource PageTitle}"/>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="96" Height="96">
                            <Ellipse Fill="{DynamicResource AccentBrush}"/>
                            <TextBlock Text="{Binding Initial}" FontSize="40" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Ellipse Visibility="{Binding HasAvatar, Converter={StaticResource B2V}}">
                                <Ellipse.Fill><ImageBrush ImageSource="{Binding Avatar}" Stretch="UniformToFill"/></Ellipse.Fill>
                            </Ellipse>
                        </Grid>
                        <StackPanel Margin="20,0,0,0" VerticalAlignment="Center">
                            <Button Style="{StaticResource AccentButton}" Command="{Binding ChooseAvatarCommand}" HorizontalAlignment="Left">
                                <TextBlock Text="Загрузить аватарку" Foreground="{DynamicResource AccentTextBrush}" FontWeight="Medium"/>
                            </Button>
                            <Button Style="{StaticResource GhostButton}" Command="{Binding RemoveAvatarCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"
                                    Visibility="{Binding HasAvatar, Converter={StaticResource B2V}}">
                                <TextBlock Text="Убрать аватарку"/>
                            </Button>
                            <TextBlock Text="PNG, JPG или BMP. Файл копируется в папку данных PAD." FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="Имя" Style="{StaticResource FieldLabel}"/>
                    <TextBox Style="{StaticResource Input}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Роль / специализация" Style="{StaticResource FieldLabel}"/>
                    <TextBox Style="{StaticResource Input}" Text="{Binding Role, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="О себе" Style="{StaticResource FieldLabel}"/>
                    <TextBox Style="{StaticResource Input}" Height="80" AcceptsReturn="True" TextWrapping="Wrap"
                             Text="{Binding About, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Начало работы" Style="{StaticResource FieldLabel}"/>
                    <DatePicker SelectedDate="{Binding StartDate}" HorizontalAlignment="Left" Width="200"/>

                    <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                        <Button Style="{StaticResource AccentButton}" Command="{Binding SaveCommand}">
                            <TextBlock Text="Сохранить" Foreground="{DynamicResource AccentTextBrush}" FontWeight="Medium"/>
                        </Button>
                        <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Margin="14,0,0,0" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Foreground" Value="{DynamicResource IncomeBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsError}" Value="True"><Setter Property="Foreground" Value="{DynamicResource OverdueBrush}"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="МОЯ СТАТИСТИКА" Style="{StaticResource SectionTitle}"/>
            <ItemsControl ItemsSource="{Binding Tiles}" ItemTemplate="{StaticResource CountTemplate}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
