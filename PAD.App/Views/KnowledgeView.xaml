<UserControl x:Class="PAD.Desktop.Views.KnowledgeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources><BooleanToVisibilityConverter x:Key="B2V"/></UserControl.Resources>
    <Grid Margin="8,8,28,24">
        <Grid.ColumnDefinitions><ColumnDefinition Width="340"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <DockPanel Margin="0,0,20,0">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Command="{Binding NewCommand}" VerticalAlignment="Center">
                    <TextBlock Text="+ Заметка" Foreground="{DynamicResource AccentTextBrush}" FontWeight="Medium"/>
                </Button>
                <TextBlock Text="База знаний" Style="{StaticResource PageTitle}" FontSize="24"/>
            </DockPanel>
            <TextBox DockPanel.Dock="Top" Style="{StaticResource Input}" Margin="0,0,0,10" ToolTip="Поиск по названию, тексту и тегам"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
            <ListBox ItemsSource="{Binding Notes}" SelectedItem="{Binding Selected}" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemContainerStyle="{StaticResource LegendRow}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Sub}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
        <StackPanel Grid.Column="1">
            <TextBlock Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,40,0,0"
                       Text="Здесь хранятся ваши заметки: договоры, чек-листы, инструкции. Выберите заметку слева или создайте новую."
                      >
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers><DataTrigger Binding="{Binding HasEditor}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <Border Style="{StaticResource Card}" Visibility="{Binding HasEditor, Converter={StaticResource B2V}}">
                <StackPanel>
                    <TextBlock Text="Название" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                    <TextBox Style="{StaticResource Input}" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Теги (через запятую)" Style="{StaticResource FieldLabel}"/>
                    <TextBox Style="{StaticResource Input}" Text="{Binding Tags, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Текст" Style="{StaticResource FieldLabel}"/>
                    <TextBox Style="{StaticResource Input}" MinHeight="300" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                             Text="{Binding Body, UpdateSourceTrigger=PropertyChanged}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Style="{StaticResource AccentButton}" Command="{Binding SaveCommand}">
                            <TextBlock Text="Сохранить" Foreground="{DynamicResource AccentTextBrush}" FontWeight="Medium"/>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Command="{Binding DeleteCommand}" Margin="8,0,0,0"><TextBlock Text="Удалить"/></Button>
                        <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Margin="14,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Foreground" Value="{DynamicResource IncomeBrush}"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding IsError}" Value="True"><Setter Property="Foreground" Value="{DynamicResource OverdueBrush}"/></DataTrigger></Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
