<Window x:Class="PAD.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PAD.Desktop.ViewModels"
        xmlns:views="clr-namespace:PAD.Desktop.Views"
        Title="PAD — Personal Administration Desk" Width="1280" Height="800" MinWidth="960" MinHeight="600"
        Background="{DynamicResource WindowBrush}">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PlaceholderViewModel}">
            <StackPanel Margin="24">
                <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="{Binding Text}" Foreground="{DynamicResource TextMutedBrush}"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="16,8,16,14">
                    <TextBlock Text="{Binding StoragePath}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                               TextWrapping="Wrap" ToolTip="{Binding StoragePath}"/>
                    <TextBlock Text="{Binding Version}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Top" Text="PAD" FontSize="18" FontWeight="Bold" Margin="18,18,0,14"/>
                <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"
                         Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource NavItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="26"/>
                                <TextBlock Text="{Binding Title}" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <ContentControl Grid.Column="1" Content="{Binding CurrentPage}"/>
    </Grid>
</Window>
