<Window x:Class="PAD.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PAD.Desktop.ViewModels"
        xmlns:views="clr-namespace:PAD.Desktop.Views"
        Title="PAD — Personal Administration Desk" Width="1400" Height="900" MinWidth="1180" MinHeight="720"
        Icon="Assets/pad.ico"
        Background="{DynamicResource WindowBrush}"
        FontFamily="Inter, Segoe UI Variable Text, Segoe UI">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><views:DashboardView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProjectsViewModel}"><views:ProjectsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:TasksViewModel}"><views:TasksView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:FinanceViewModel}"><views:FinanceView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ArchiveViewModel}"><views:ArchiveView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProfileViewModel}"><views:ProfileView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:CalendarViewModel}"><views:CalendarView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:KnowledgeViewModel}"><views:KnowledgeView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:TemplatesViewModel}"><views:TemplatesView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SearchViewModel}"><views:SearchView/></DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Боковая панель (glass) -->
        <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="0" Direction="0" Opacity="0.12" Color="#000000"/>
            </Border.Effect>
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <Button Style="{StaticResource RowButton}" Command="{Binding OpenProfileCommand}" Margin="12,0" ToolTip="Открыть профиль">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="40" Height="40">
                                <Ellipse Fill="{DynamicResource AccentBrush}"/>
                                <TextBlock Text="{Binding UserInitial}" FontWeight="SemiBold" FontSize="16" Foreground="{DynamicResource AccentTextBrush}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Ellipse Visibility="{Binding HasAvatar, Converter={StaticResource B2V}}">
                                    <Ellipse.Fill><ImageBrush ImageSource="{Binding Avatar}" Stretch="UniformToFill"/></Ellipse.Fill>
                                </Ellipse>
                            </Grid>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center" MaxWidth="150">
                                <TextBlock Text="{Binding UserName}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding UserRole}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <StackPanel Margin="20,12,16,20">
                        <TextBlock Text="Данные хранятся только на этом компьютере" FontSize="11" TextWrapping="Wrap"
                                    Foreground="{DynamicResource TextMutedBrush}" ToolTip="{Binding StoragePath}"/>
                        <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0">
                            <Run Text="{Binding Version, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding DbSize, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,24,0,20">
                    <Image Source="Assets/pad-logo.png" Width="40" Height="40"/>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="PAD" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="Personal Administration Desk" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                    </StackPanel>
                </StackPanel>

                <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"
                          Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource NavItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="24"
                                            Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Medium" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <DockPanel Grid.Column="1">
            <Grid DockPanel.Dock="Top" Margin="28,20,32,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                        CornerRadius="999" Padding="16,0" Height="44" MaxWidth="520" HorizontalAlignment="Left">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="2" Direction="270" Opacity="0.08" Color="#000000"/>
                    </Border.Effect>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                    Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBox Style="{StaticResource BareInput}" Width="420" VerticalContentAlignment="Center"
                                  Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                  ToolTip="Поиск по проектам, задачам, заметкам и шаблонам. Enter — найти">
                            <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding RunSearchCommand}"/></TextBox.InputBindings>
                        </TextBox>
                    </DockPanel>
                </Border>
                <StackPanel Grid.Column="1" Margin="0,0,24,0" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding TimeText}" FontSize="16" FontWeight="SemiBold" TextAlignment="Right"/>
                    <TextBlock Text="{Binding DateText}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextAlignment="Right"/>
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource AccentButton}" Command="{Binding NewProjectCommand}" Height="44">
                    <TextBlock Text="+  Создать проект" Foreground="{DynamicResource AccentTextBrush}" FontWeight="SemiBold"/>
                </Button>
            </Grid>

            <ContentControl Content="{Binding CurrentPage}" Margin="0"/>
        </DockPanel>
    </Grid>
</Window>
