<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PAD</AssemblyName>
    <RootNamespace>PAD.Desktop</RootNamespace>
    <Version>1.0.0</Version>
    <ApplicationIcon>Assets\pad.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\pad-logo.png" />
    <Resource Include="Assets\pad.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PAD.Data\PAD.Data.csproj" />
  </ItemGroup>
</Project>
